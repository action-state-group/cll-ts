{
  "name": "capsule-ledger-ts",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "TypeScript Checkpointed Local Log with MMR proofs, signed checkpoints, durable stores, and an AAC ledger binding",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cborg": "6.1.2",
    "capsule-emit-ts": "file:../capsule-emit-ts",
    "fs-ext": "2.1.1",
    "mysql2": "3.24.3"
  },
  "devDependencies": {
    "@testcontainers/mysql": "11.7.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/fs-ext": "2.0.3",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.81.0",
    "prettier": "3.6.2",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
